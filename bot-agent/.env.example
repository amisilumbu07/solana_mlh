# Copy to .env. Never commit .env, and never put these values in frontend code.

PORT=3001
TARGET_WHALE_ADDRESS=0x0000000000000000000000000000000000000000
MIN_WHALE_NOTIONAL_USDC=100
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Risk thresholds (0-1). AUTO_EXECUTE lets strong signals place orders with no human step.
MIN_CONFIDENCE=0.65
MAX_RISK_SCORE=0.7
AUTO_EXECUTE=false

# Firecrawl: live news for the validation loop. Without it, no trade can pass validation.
FIRECRAWL_API_KEY=

# Validation loop
MAX_TRADE_AGE_SECONDS=120
MAX_SLIPPAGE=0.02
MIN_CORROBORATING_DOMAINS=2

# Execution. Anything other than EXECUTION_MODE=live is a dry run that sends no orders.
EXECUTION_MODE=dry_run
COPY_RATIO=0.01
MIN_ORDER_USDC=1
MAX_ORDER_USDC=5
MAX_DAILY_USDC=25

# Needed only for EXECUTION_MODE=live. Use a dedicated wallet holding only what you can lose.
POLYMARKET_PRIVATE_KEY=
# 0 = plain wallet, 1 = Polymarket email/magic proxy, 2 = browser wallet proxy
POLYMARKET_SIGNATURE_TYPE=0
# Polymarket proxy wallet address, needed when the signature type is 1 or 2
POLYMARKET_FUNDER=
POLYGON_RPC_URL=

# x402: agents pay X402_PAY_TO to get a session token. Leave blank to disable paid sessions.
X402_PAY_TO=
X402_SESSION_PRICE=$0.05
# eip155:84532 = Base Sepolia testnet, eip155:8453 = Base mainnet
X402_NETWORK=eip155:84532
# This facilitator is testnet only. Mainnet needs a production facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Comma-separated payer wallets allowed to execute trades. Everyone else can only analyze.
X402_EXECUTE_ALLOWLIST=

# Signs session tokens, 32+ characters: openssl rand -hex 32
AGENT_SESSION_SECRET=
SESSION_TTL_SECONDS=3600
SESSION_MAX_ANALYSES=20

# LLM. Options: claude, openai, gpt4free, ollama
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=
# OLLAMA_ENDPOINT=http://localhost:11434
# GPT4FREE_ENDPOINT=http://localhost:8000
# LLM_ENDPOINT=http://localhost:8000
# LLM_API_KEY=
# QUICKNODE_RPC_URL=

# Optional overrides
# POLYMARKET_DATA_URL=https://data-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# ---------------------------------------------------------------------------
# Phase 3 services (tradeExecutor, transactionManager, settlementObserver,
# mediaGenerator). These are not wired into the agent yet. If tradeExecutor is
# connected, route it through the validation loop in copyPipeline.ts, or its
# trades will skip the web checks and spending limits.
# ---------------------------------------------------------------------------
POLYGON_AMOY_RPC=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_WALLET_PRIVATE_KEY=0x...
POLYGON_WALLET_ADDRESS=0x...
MARKET_CONTRACT_ADDRESS=0x...
MARKET_CONTRACT_ABI=[...]
MAX_POSITION_SIZE_USD=1000
KELLY_FRACTION=0.25
MIN_EXECUTION_CONFIDENCE=0.6
BANKROLL=10000
GAS_LIMIT=300000
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_MEDIA_GENERATION=true
MEDIA_STORAGE_PATH=./media
TWITTER_AUTO_POST=false
DISCORD_WEBHOOK_URL=
DATABASE_URL=
NODE_ENV=development
LOG_LEVEL=info
DEBUG=false
MIN_CONFIRMATIONS=6
POLLING_INTERVAL=30000
ENABLE_TRANSACTION_LOGGING=true
TRANSACTION_LOG_PATH=./logs
